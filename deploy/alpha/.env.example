# Copy to deploy/alpha/.env and replace every placeholder locally. Never commit that file.
POSTGRES_NEWAPI_PASSWORD=<GENERATE_A_RANDOM_DATABASE_PASSWORD>
POSTGRES_ACU_PASSWORD=<GENERATE_A_DIFFERENT_RANDOM_DATABASE_PASSWORD>
NEW_API_SESSION_SECRET=<GENERATE_AT_LEAST_32_RANDOM_BYTES>
ACU_TRUSTED_IDENTITY_SECRET=<GENERATE_AT_LEAST_32_RANDOM_BYTES>
ACU_ADMIN_TRACE_TOKEN=<GENERATE_A_SEPARATE_AT_LEAST_32_BYTE_ADMIN_TOKEN>

# Local sibling checkout of New API revision bc14c18f6024e79cba1c08d02cd007796e12d668.
NEW_API_SOURCE_DIR=../../../new-api
NEW_API_BIND_ADDRESS=127.0.0.1
NEW_API_PORT=3100

CLOSEAI_OPENAI_BASE_URL=https://api.openai-proxy.org/v1
CLOSEAI_ANTHROPIC_BASE_URL=https://api.openai-proxy.org/anthropic
CLOSEAI_API_KEY=<TEST_PROVIDER_KEY_ONLY>

# Live Judge uses the same isolated CloseAI test account by default, but the
# variable is separate so operators can rotate or isolate Judge credentials.
ACU_JUDGE_API_KEY=<TEST_JUDGE_KEY_ONLY>
ACU_JUDGE_MODEL=deepseek-v4-flash
ACU_JUDGE_BASE_URL=https://api.openai-proxy.org/v1
ACU_JUDGE_TIMEOUT_MS=20000
ACU_JUDGE_MAX_CONTEXT_TOKENS=6000
