# Protocol reconnaissance only. Copy to .env.protocol-recon and keep it local.
# Never commit real credentials or captured private source material.

# Public New API endpoint used by the native clients.
NEW_API_BASE_URL=
# Test-only New API key. Requires a funded, disposable test user.
NEW_API_TEST_KEY=
# Isolated New API administrative values; keep the populated file outside Git.
NEW_API_ROOT_USERNAME=
NEW_API_ROOT_PASSWORD=
NEW_API_TEST_USERNAME=
NEW_API_TEST_PASSWORD=
NEW_API_IMAGE_DIGEST=
# ACU endpoint reached by New API or a capture proxy.
ACU_BASE_URL=
# OpenRouter test credential (presence is recorded; the value is never captured).
OPENROUTER_API_KEY=
# CloseAI OpenAI-compatible base URL; usually ends in /v1.
CLOSEAI_BASE_URL=
# CloseAI Anthropic-compatible base URL; add /anthropic before /v1/messages.
CLOSEAI_ANTHROPIC_BASE_URL=
# CloseAI test credential.
CLOSEAI_API_KEY=
# Dedicated native-client configuration directories outside the repository.
CLAUDE_CONFIG_DIR=
CODEX_HOME=
# Repository-external directory for unsanitized captures.
PROTOCOL_CAPTURE_DIR=
# Capture point label for this proxy instance: A, B, C, or D.
PROTOCOL_CAPTURE_POINT=
# Absolute upstream base URL for this proxy instance.
PROTOCOL_CAPTURE_UPSTREAM=
# Local listen host and port. Use separate ports for separate capture points.
PROTOCOL_CAPTURE_HOST=127.0.0.1
PROTOCOL_CAPTURE_PORT=9081
