m\":true,\"tools\":[],\"output_config\":{\"effort\":\"high\",\"format\":{\"type\":\"json_schema\",\"schema\":{\"type\":\"object\",\"properties\":{\"title\":{\"type\":\"string\"}},\"required\":[\"title\"],\"additionalProperties\":false}}},\"metadata\":{\"user_id\":\"<REDACTED_USER_ID_1>\"}}",
