{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clawrouter.local/schemas/protocol-fixture-manifest-v1.json",
  "title": "ACU native protocol fixture manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixture_id",
    "captured_at",
    "client",
    "client_version",
    "os",
    "newapi_version",
    "acu_commit",
    "provider",
    "requested_model",
    "actual_model",
    "protocol",
    "stream",
    "scenario",
    "request_count",
    "contains_tools",
    "contains_reasoning",
    "contains_plan_signal",
    "capture_points",
    "sanitized",
    "capture_status"
  ],
  "properties": {
    "fixture_id": { "type": "string", "minLength": 1 },
    "captured_at": { "type": "string", "format": "date-time" },
    "client": { "enum": ["codex", "claude-code"] },
    "client_version": { "type": "string", "minLength": 1 },
    "os": { "type": "string", "minLength": 1 },
    "newapi_version": { "type": "string", "minLength": 1 },
    "acu_commit": { "type": "string", "minLength": 1 },
    "provider": { "type": "string", "minLength": 1 },
    "requested_model": { "type": "string", "minLength": 1 },
    "actual_model": { "type": "string", "minLength": 1 },
    "protocol": { "enum": ["responses", "messages", "chat_completions"] },
    "stream": { "type": "boolean" },
    "scenario": { "type": "string", "minLength": 1 },
    "request_count": { "type": "integer", "minimum": 0 },
    "contains_tools": { "type": "boolean" },
    "contains_reasoning": { "type": "boolean" },
    "contains_plan_signal": { "type": "boolean" },
    "capture_points": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["A", "B", "C", "D"] }
    },
    "sanitized": { "const": true },
    "capture_status": { "enum": ["complete", "partial", "blocked", "failed"] }
  }
}
