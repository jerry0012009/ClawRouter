ess that URL\\\"}\\nBad (English title for a Korean session): {\\\"title\\\": \\\"Refactor payment module\\\"}\"}],\"tools\":[],\"metadata\":{\"user_id\":\"<REDACTED_USER_ID_1>\"},\"max_tokens\":32000,\"thinking\":{\"type\":\"disabled\"},\"temperature\":1,\"output_config\":{\"format\":{\"type\":\"json_schema\",\"schema\":{\"type\":\"object\",\"properties\":{\"title\":{\"type\":\"string\"}},\"required\":[\"title\"],\"additionalProperties\":false}}},\"stream\":true}",
