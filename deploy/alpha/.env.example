# Copy to deploy/alpha/.env and replace every placeholder locally. Never commit that file.
POSTGRES_NEWAPI_PASSWORD=<GENERATE_A_RANDOM_DATABASE_PASSWORD>
POSTGRES_ACU_PASSWORD=<GENERATE_A_DIFFERENT_RANDOM_DATABASE_PASSWORD>
NEW_API_SESSION_SECRET=<GENERATE_AT_LEAST_32_RANDOM_BYTES>
ACU_TRUSTED_IDENTITY_SECRET=<GENERATE_AT_LEAST_32_RANDOM_BYTES>
ACU_ADMIN_TRACE_TOKEN=<GENERATE_A_SEPARATE_AT_LEAST_32_BYTE_ADMIN_TOKEN>

# Local sibling checkout of the validated New API RC2.2 branch.
NEW_API_SOURCE_DIR=../../../new-api
NEW_API_BIND_ADDRESS=127.0.0.1
NEW_API_PORT=3100

CLOSEAI_OPENAI_BASE_URL=https://api.openai-proxy.org/v1
CLOSEAI_ANTHROPIC_BASE_URL=https://api.openai-proxy.org/anthropic
CLOSEAI_API_KEY=<TEST_PROVIDER_KEY_ONLY>
LUCEN_BASE_URL=https://lucen.cc
LUCEN_API_KEY=<TEST_PROVIDER_KEY_ONLY>
BLACKAI_BASE_URL=https://blackaicoding.com
BLACKAI_API_KEY=<TEST_PROVIDER_KEY_ONLY>

# Primary Judge uses the direct Xiaomi MiMo Token Plan API. CloseAI remains the
# independently credentialed DeepSeek backup.
MIMO_API_KEY=<XIAOMI_MIMO_TOKEN_PLAN_KEY>
ACU_JUDGE_API_KEY=<TEST_JUDGE_KEY_ONLY>
ACU_JUDGE_BASE_URL=https://api.openai-proxy.org/v1
ACU_JUDGE_TIMEOUT_MS=20000
ACU_JUDGE_MAX_CONTEXT_TOKENS=6000
ACU_JUDGE_ROLLBACK_TO_BACKUP=false

# Injected by the versioned deployment command. Never leave these as unknown in production.
CLAWROUTER_BUILD_COMMIT_SHA=<CLAWROUTER_COMMIT_SHA>
CLAWROUTER_BUILD_BRANCH=productization/alpha-rc1-validation
NEW_API_BUILD_COMMIT_SHA=<NEW_API_COMMIT_SHA>
NEW_API_BUILD_BRANCH=acu/alpha-rc1-validation
BUILD_TIME=<RFC3339_BUILD_TIME>

# Operator-only paid validation gate. These values are consumed by
# tools/rc1-validation and are not passed into the production Router process.
ACU_LIVE_TEST_ENABLED=false
ACU_TEST_RUN_BUDGET_CNY=5
ACU_TEST_TOTAL_BUDGET_CNY=30
ACU_TEST_MAX_CONCURRENCY=1
ACU_TEST_MAX_OUTPUT_TOKENS=4096
ACU_TEST_REQUIRE_APPROVAL_ABOVE_CNY=5
ACU_TEST_COST_APPROVED=false
ACU_TEST_USD_TO_CNY=7.2
ACU_TEST_BUDGET_STATE_FILE=/var/lib/acu-protocol-recon/live-test-budget.json
